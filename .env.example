# Copy to .env and fill in real values. .env is gitignored.
# Each service reads DATABASE_URL; docker-compose maps the per-service vars below into it.

USER_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/users
LOG_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/logs
ALERT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/alerts
EXTERNAL_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/FinanceData
AI_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/aiBackend

JWT_SECRET_KEY=change-me-to-a-long-random-string
